{
  // Realtime Database rules - only ever holds live player-position
  // presence now (see public/js/mining.js's file header and
  // server/lib/mining-session.js for why that's a Firestore-quota-hostile
  // workload, and why RTDB - metered by connections/bandwidth on Spark,
  // not per read/write - is the right store for it instead). Firestore
  // (firestore.rules) still owns everything else: nodes, mining sessions,
  // workers, inventory.
  //
  // Unlike Firestore, position here is written by the CLIENT directly,
  // not the Express server - there's no anti-cheat reason it has to go
  // through the backend (charX/charY are already untrusted, client-
  // reported data everywhere else in this codebase too; see mining.js's
  // longstanding movement/anti-cheat caveat).
  //
  // Each presence node's key is an opaque push() id, NOT the account
  // name - RTDB keys can't contain '.', '#', '$', '[', or ']', and WAX
  // account names routinely contain '.' (e.g. "foo.bar.wam"). The real
  // account name instead lives as a FIELD inside the node
  // (mining.js's armPresenceForCurrentLocation()), so these rules check
  // that field rather than the path when deciding who owns a node:
  // - creating a node requires its own `account` field to equal your
  //   Firebase Auth uid (which is only ever set to a WAX account name
  //   that proved key ownership - see firestore.rules) - you can't claim
  //   to be someone else.
  // - updating or deleting an EXISTING node requires that node's current
  //   `account` field to already be yours - you can't touch anyone
  //   else's, including to delete it.
  "rules": {
    ".read": false,
    ".write": false,

    "presence": {
      "$locationId": {
        // Anyone can read a location's whole presence list - that's what
        // lets every other client render a ghost for you.
        ".read": true,

        "$pushId": {
          ".write": "auth != null && (!data.exists() || data.child('account').val() === auth.uid)",
          ".validate": "newData.hasChildren(['account', 'charX', 'charY', 'updatedAtMs'])",
          "account": { ".validate": "newData.isString() && newData.val() === auth.uid" },
          "charX": { ".validate": "newData.isNumber()" },
          "charY": { ".validate": "newData.isNumber()" },
          "updatedAtMs": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
