rules_version = '2';

// Security model:
// - Clients read directly from Firestore (for real-time listeners).
// - Clients NEVER write directly. Every write goes through a Cloud
//   Function, which runs with the Admin SDK (bypasses these rules) and
//   only after verifying request.auth.uid matches a WAX account that
//   proved key ownership via the signature-verification flow in
//   functions/lib/verify-signature.js.
//
// request.auth.uid, when set, is a WAX account name - it is only ever
// set by admin.auth().createCustomToken(accountName) after signature
// verification succeeds (see functions/index.js: verifyLogin).
//
// Live player-position presence (public/js/mining.js) lives in the
// Realtime Database instead (see database.rules.json), not here - it's a
// high-frequency, ephemeral workload that doesn't fit Firestore's
// per-operation Spark-plan quota, and unlike everything in this file it's
// written directly by the client, not a Cloud Function.

service cloud.firestore {
  match /databases/{database}/documents {

    match /workers/{account} {
      allow read: if true;
      allow write: if false; // functions only
    }

    // NOTE: the rule above does NOT cascade to subcollections - Firestore
    // rules only apply to the exact path matched, so inventory needed its
    // own explicit rule or the inventory panel's onSnapshot() would fail
    // with a permission-denied.
    match /workers/{account}/inventory/{itemId} {
      allow read: if true;
      allow write: if false; // functions only
    }

    match /sysdata/{doc} {
      allow read: if true;
      allow write: if false;
    }

    match /locations/{locationId}/nodes/{nodeId} {
      allow read: if true;
      allow write: if false;
    }

    // Short-lived server-side state for the orbit-mining flow (see
    // server/lib/mining-session.js) - purely an implementation detail the
    // server uses to clamp client-claimed hit counts against real elapsed
    // time. Never read or written by clients directly.
    match /miningSessions/{account} {
      allow read: if false;
      allow write: if false;
    }

    // Public counterpart to the above: "this account is currently orbiting
    // this node" (plus their frozen charX/charY and a validating flag),
    // written by the server on /startMining and cleared on /mineNode - see
    // mining-session.js. Readable by anyone so other players' clients can
    // render your swing (and "Validating..." while your finishing batch is
    // in flight) without needing a full player-position sync.
    match /locations/{locationId}/miningActivity/{account} {
      allow read: if true;
      allow write: if false; // server only
    }

    // Short-lived nonces used for the WAX login proof. Not client-readable
    // (the client already knows its own nonce from the callable response)
    // and never client-writable.
    match /authNonces/{account} {
      allow read: if false;
      allow write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
